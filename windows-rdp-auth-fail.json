// 🔐 Workbook: Windows RDP Auth Failures (Map View)
// Description: Azure Workbook visualization that maps failed RDP login attempts from honeypot Windows VMs.
// - Uses GeoIP-enriched IP data
// - Based on SecurityEvent log (Event ID 4625, Logon Type 10)
// - Displays attack origin by country and city
// 🧭 How to Use:
//   1. Go to Azure Sentinel → Workbooks
//   2. Click "New" → "Advanced Editor"
//   3. Paste the contents of this file (without comment lines)
4. Save & Run to visualize


{
  "type": 3,
  "content": {
    "version": "KqlItem/1.0",
    "query": "let GeoIPDB = _GetWatchlist('geoip');\r\nGeoIPDB\r\n| where isnotempty(latitude) and isnotempty(longitude)\r\n| project countryname, cityname, latitude, longitude\r\n| summarize Count = count() by countryname, cityname, latitude, longitude",
    "size": 0,
    "timeContext": {
      "durationMs": 86400000
    },
    "queryType": 0,
    "resourceType": "microsoft.operationalinsights/workspaces",
    "visualization": "map",
    "mapSettings": {
      "locInfo": "CountryRegion",
      "locInfoColumn": "countryname",
      "latitude": "latitude",
      "longitude": "longitude",
      "sizeSettings": "Count",
      "sizeAggregation": "Max",
      "minSize": 20,
      "legendMetric": "Count",
      "legendAggregation": "Sum",
      "itemColorSettings": null
    }
  },
  "name": "query - 1"
}
